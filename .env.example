# Gemini: copy this file to .env and set your key on the server.
# Use NYAYA_PROVIDER=demo for the limited offline rules demo.
NYAYA_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# For Ollama: provider=ollama, URL=http://localhost:11434/v1, model=qwen2.5:3b
# For another compatible server: provider=openai and supply its /v1 base URL.
NYAYA_BASE_URL=http://localhost:11434/v1
NYAYA_MODEL=qwen2.5:3b
NYAYA_API_KEY=
